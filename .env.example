# Copy to .env for local work. Use a fresh, private value before deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
# Leave unset for local SQLite. On Render, set this to the Neon pooled
# connection string in the Render Dashboard (not in this file).
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional demo seed overrides. Never use these values in production.
# SEED_ADMIN_PASSWORD=change-me
# SEED_PROVIDER_PASSWORD=change-me

# Set to 1 when the site is served over HTTPS (Render and PythonAnywhere).
# SESSION_COOKIE_SECURE=1
